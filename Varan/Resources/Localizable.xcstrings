    "server.alerts.thresholds.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozentwerte von 0 bis 100 eingeben. Die Warnschwelle darf die Kritisch-Schwelle nicht überschreiten. Beide Werte müssen verfügbar sein, um ein Paar zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter percentages from 0 to 100. Warning must not exceed critical. Both values must be available to edit a pair."
          }
        }
      }
    },
    "server.alerts.validation.order" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
