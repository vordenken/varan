    "%.1f / %.1f %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$.1f / %2$.1f %3$@"
          }
        }
      }
    },
    "%.1f %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$.1f %2$@"
          }
        }
      }
    },
    "%@ %lld" : {
      "localizations" : {
        "en" : {
