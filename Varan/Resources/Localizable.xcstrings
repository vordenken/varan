    "settings.systemNotifications.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varan sendet Mitteilungen über neue Ereignisse, die die aktive App erkennt. Für die Zustellung bei geschlossener App sind Push-Mitteilungen nötig; diese sind noch nicht eingerichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varan sends notifications for new events it detects while the app is active. Delivery while the app is closed requires push notifications, which are not configured yet."
          }
        }
      }
    },
    "settings.systemNotifications.permissionDenied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind in den Systemeinstellungen deaktiviert. Erlaube sie dort für Varan, um diese Funktion zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are disabled in System Settings. Allow notifications for Varan there to use this feature."
          }
        }
      }
